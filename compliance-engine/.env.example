# Αντέγραψε σε .env και συμπλήρωσε τις τιμές. Το .env ΔΕΝ μπαίνει στο git.
# Στο VM το deploy.sh το δημιουργεί αυτόματα την πρώτη φορά (με τυχαίο API key).

# Μόνο localhost: το εργαλείο το καλεί η πλατφόρμα από το ίδιο μηχάνημα
HOST=127.0.0.1
PORT=5100

# Κοινό μυστικό με την πλατφόρμα (τουλάχιστον 32 χαρακτήρες), π.χ.: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-value-of-32-chars-or-more

# Προαιρετικά: πού αποθηκεύονται τα reports και τα logs αποφάσεων (προεπιλογή: compliance-engine/data)
# DATA_DIR=/var/lib/compliance-engine

# Προαιρετικά: επανεξέταση του cluster (POST /cluster/scan) με kube-bench και έλεγχο του Pod Security Admission
# KUBECONFIG=/home/<user>/.kube/config          # προεπιλογή: ~/.kube/config αν υπάρχει
# KUBECTL=kubectl
# CLUSTER_NAMESPACES=workstations                # namespaces των workloads (έλεγχος των labels του PSA), χωρισμένα με κόμμα
# CLUSTER_SCAN_NAMESPACE=compliance-system       # εκεί τρέχει το Job του kube-bench (privileged)
# KUBE_BENCH_IMAGE=docker.io/aquasec/kube-bench:v0.15.6
# KUBE_BENCH_BENCHMARK=                          # κενό = αυτόματη αναγνώριση (π.χ. k3s-cis-1.x)
# CLUSTER_SCAN_TIMEOUT_SECONDS=300
