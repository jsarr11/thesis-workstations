FROM workstation-base:v1

USER root

# Install Node.js, Python3, Go SDK & build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    npm \
    python3 \
    python3-pip \
    golang-go \
    build-essential \
    make \
    && rm -rf /var/lib/apt/lists/*

USER 1000
