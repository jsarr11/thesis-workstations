# Αντέγραψε σε .env και συμπλήρωσε τις τιμές. Το .env ΔΕΝ μπαίνει στο git.
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=thesis_admin
DB_PASSWORD=change-me
DB_NAME=thesis_workstations_db

K8S_NAMESPACE=default

# Προαιρετικά: η διεύθυνση που μπαίνει στα access URLs των workstations.
# Αν λείπει, χρησιμοποιείται η διεύθυνση με την οποία άνοιξε ο χρήστης το portal.
# PUBLIC_HOST=192.168.1.248

# Προαιρετικά: πόσο περιμένει ο Manager να γίνει Ready το Pod (ms)
# POD_READY_TIMEOUT_MS=120000

# Προαιρετικά: μέγιστη διάρκεια συνεδρίας ενός workstation σε ώρες (μετά διαγράφεται αυτόματα)
# SESSION_TTL_HOURS=10

# Προαιρετικά: ζώνη ώρας για το ημερήσιο export των audit logs
# REPORT_TIMEZONE=Europe/Athens

# Προαιρετικά: διάρκεια σύνδεσης (login) σε ώρες
# LOGIN_SESSION_HOURS=12

# Προαιρετικά: μέγιστος αριθμός ενεργών/εκκρεμών workstations ανά developer
# MAX_OPEN_WORKSTATIONS_PER_USER=2

# Σε HTTPS (π.χ. στο cloud πίσω από TLS) βάλε true, ώστε το cookie σύνδεσης να μη στέλνεται ποτέ σε HTTP
# COOKIE_SECURE=false

# Compliance Engine (ξεχωριστή υπηρεσία, φάκελος compliance-engine/). Το deploy.sh τα συμπληρώνει αυτόματα στο VM.
# Χωρίς αυτά, κανένα workstation δεν γίνεται deploy (fail-closed).
COMPLIANCE_ENGINE_URL=http://127.0.0.1:5100
COMPLIANCE_ENGINE_API_KEY=ίδιο-με-το-API_KEY-του-compliance-engine/.env
# COMPLIANCE_ENGINE_TIMEOUT_MS=10000
